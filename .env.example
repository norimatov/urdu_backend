PORT=4000
DATABASE_URL=postgres://urdu:urdu@localhost:5432/urdu_connect
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ADMIN_JWT_SECRET=another-long-random-string-for-admin-32-chars-min
# Admin akkaunt faqat shu yerda saqlanadi (bazada yo'q)
ADMIN_EMAIL=you@example.com
# npm run hash-password -- "kuchli-parol" natijasini qo'ying
ADMIN_PASSWORD_HASH=
# Ta'sischilar bilan aloqa so'rovlari shu manzilga boradi (frontendga chiqmaydi)
FOUNDER_EMAIL=
CLIENT_ORIGIN=http://localhost:5173
# SMTP bo'sh bo'lsa kodlar terminalga chiqadi (dev rejim)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=URDU CONNECT <no-reply@urdu.connect>
# Telefon SMS uchun webhook (POST {to, text}). Bo'sh bo'lsa kodlar terminalga chiqadi
SMS_WEBHOOK_URL=
